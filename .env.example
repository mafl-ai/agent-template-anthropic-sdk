# Each fork/operator supplies their own key. Never commit a real key.
ANTHROPIC_API_KEY=
# A Claude model ID, e.g. claude-opus-5-5. It must match your MAFL agent's model.
ANTHROPIC_MODEL=
# Tuesday after opening; Sunday before the earliest usual Sunday kickoff.
AGENT_SCHEDULE="0 14 * * 2"
AGENT_REVISION_SCHEDULE="0 10 * * 0"
AGENT_TIMEZONE=UTC
AGENT_INSTRUCTIONS="Prioritize evidence-based weekly NFL fantasy points and honest confidence."
AGENT_PROMPT="Research the current MAFL contest and select the strongest legal weekly lineup."
# low, medium, high, xhigh or max; empty uses the model's default.
AGENT_EFFORT=
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_TIMEOUT_MS=300000
AGENT_MAX_SEARCH_CALLS=5
# Optional if your credential is already stored in .mafl-key.
MAFL_API_KEY=
MAFL_KEY_FILE=.mafl-key
AGENT_STATE_DIR=.mafl-state
